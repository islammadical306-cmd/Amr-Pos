# GEMINI_API_KEY: Required for Gemini AI Vision & OCR product recognition.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional signing key for POS staff sessions (defaults to secure random key in memory).
SESSION_SECRET=

# SMS_ENCRYPTION_KEY: Optional key used to encrypt saved Bulk SMS Gateway credentials in SQLite.
SMS_ENCRYPTION_KEY=

# SMS_GATEWAY_API_KEY: Optional fallback API key for the default Bulk SMS gateway.
SMS_GATEWAY_API_KEY=

# SMS_GATEWAY_SENDER_ID: Optional default Sender ID for Bulk SMS gateway.
SMS_GATEWAY_SENDER_ID=

